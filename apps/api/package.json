{
  "name": "@familyhub/api",
  "version": "0.1.0",
  "private": true,
  "description": "FamilyHub API (NestJS): verifies Supabase sessions and runs server-side logic as the user",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=.env dist/main.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@familyhub/shared": "^0.1.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/throttler": "^6.7.1",
    "@supabase/supabase-js": "^2.118.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsc-watch": "^7.2.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "type": "module"
}
