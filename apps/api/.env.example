# FamilyHub API configuration. Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Supabase project settings (Dashboard > Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only for local Supabase or projects still on the legacy HS256 JWT secret.
# SUPABASE_JWT_SECRET=

# Comma-separated browser origins allowed to call the API (none needed for the mobile app).
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120
