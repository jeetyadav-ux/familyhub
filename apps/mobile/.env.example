# FamilyHub mobile app configuration. Copy to .env (never commit .env).
# These values are public by design (the anon key is safe to ship; RLS protects data).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# NestJS API base URL (used from Phase 2). For a phone on the same Wi-Fi use your computer's LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
